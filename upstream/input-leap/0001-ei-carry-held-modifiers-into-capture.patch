diff --git a/src/lib/platform/EiKeyState.cpp b/src/lib/platform/EiKeyState.cpp
index e8f3e9e..91f7ad6 100644
--- a/src/lib/platform/EiKeyState.cpp
+++ b/src/lib/platform/EiKeyState.cpp
@@ -22,6 +22,11 @@
 #include <cstddef>
 #include <algorithm>
 #include <memory>
+#include <cstring>
+#include <dirent.h>
+#include <fcntl.h>
+#include <linux/input.h>
+#include <sys/ioctl.h>
 #include <unistd.h>
 
 #include <xkbcommon/xkbcommon.h>
@@ -278,4 +283,55 @@ void EiKeyState::update_xkb_state(uint32_t keyval, bool is_pressed)
     xkb_state_update_key(xkb_state_, keyval, is_pressed ? XKB_KEY_DOWN : XKB_KEY_UP);
 }
 
+void EiKeyState::update_xkb_mask(std::uint32_t depressed, std::uint32_t latched,
+                                 std::uint32_t locked, std::uint32_t group)
+{
+    LOG_DEBUG1("update_xkb_mask depressed=0x%x latched=0x%x locked=0x%x group=%d",
+               depressed, latched, locked, group);
+    xkb_state_update_mask(xkb_state_, depressed, latched, locked, 0, 0, group);
+}
+
+// Modifiers pressed before input capture began never reach us as EI key
+// events, and the compositor is not required to send its modifier state on
+// activation, so a modifier held across the screen edge would be lost. Rebuild
+// the xkb state from the kernel's view of the modifier keys instead. Needs read
+// access to /dev/input (the input group); without it this just clears state
+// left over from the previous capture.
+void EiKeyState::sync_held_modifiers()
+{
+    static const int mods[] = { KEY_LEFTCTRL, KEY_RIGHTCTRL, KEY_LEFTSHIFT, KEY_RIGHTSHIFT,
+                                KEY_LEFTALT, KEY_RIGHTALT, KEY_LEFTMETA, KEY_RIGHTMETA };
+    constexpr std::size_t bits = 8 * sizeof(unsigned long);
+    unsigned long held[(KEY_MAX + bits) / bits] = {};
+
+    if (DIR* dir = opendir("/dev/input")) {
+        while (dirent* e = readdir(dir)) {
+            if (strncmp(e->d_name, "event", 5) != 0)
+                continue;
+            int fd = openat(dirfd(dir), e->d_name, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+            if (fd < 0)
+                continue;
+            unsigned long keys[sizeof(held) / sizeof(held[0])] = {};
+            if (ioctl(fd, EVIOCGKEY(sizeof(keys)), keys) >= 0)
+                for (std::size_t i = 0; i < sizeof(held) / sizeof(held[0]); i++)
+                    held[i] |= keys[i];
+            close(fd);
+        }
+        closedir(dir);
+    }
+
+    auto locked = xkb_state_serialize_mods(xkb_state_, XKB_STATE_MODS_LOCKED);
+    auto group = xkb_state_serialize_layout(xkb_state_, XKB_STATE_LAYOUT_EFFECTIVE);
+    xkb_state_unref(xkb_state_);
+    xkb_state_ = xkb_state_new(xkb_keymap_);
+    xkb_state_update_mask(xkb_state_, 0, 0, locked, 0, 0, group);
+
+    for (int key : mods) {
+        if ((held[key / bits] >> (key % bits)) & 1) {
+            LOG_DEBUG("modifier key %d held at capture start", key);
+            xkb_state_update_key(xkb_state_, key + 8, XKB_KEY_DOWN);
+        }
+    }
+}
+
 } // namespace inputleap
