#!/bin/sh

# Unconditional "go to Ryuk" from the Mac - the mirror of SUPER+C on Ryuk.
# Bound to alt-c in aerospace.toml.
#
# NOTE it does NOT fake anything locally: input-leap only reacts to synthetic
# pointer motion on the SERVER, so this asks Ryuk to run il-jump linux, which
# walks the shared cursor off the Mac edge facing Ryuk and then recentres on
# Ryuk. Physical SUPER+C can't be used here: server.conf swaps ctrl/super on
# the Mac screen, so it arrives as Ctrl+C and would shadow terminal interrupt.
#
# Fast path: one line into the il-hop-pipe agent's live ssh session (~10ms,
# HOP-04). If the agent is down, nc fails at once and this falls back to a
# fresh ssh (~80ms warm, ~1.6s cold).

# Per-machine settings (ilhop config, written by install.sh).
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ilhop/config"
[ -r "$CONF" ] && . "$CONF"
LINUX_HOST="${ILHOP_LINUX_HOST:-ryuk}"   # ssh alias for the Linux machine
SOCK="$HOME/.local/state/il-hop.sock"
SIDEF="$HOME/.local/state/il-hop.side"   # see il-hop-pipe
send() { printf '%s\n' "$1" | /usr/bin/nc -U "$SOCK" 2>/dev/null; }

# Which side of Ryuk this Mac sits on, as the live session's listener last
# said. Builtins only: this is on the Mac->Linux hot path. Only an exact
# `side left|right` line counts; the file also holds whatever ssh printed.
mside=
if [ -r "$SIDEF" ]; then
    while read -r k v; do
        [ "$k" = side ] || continue
        case "$v" in left|right) mside=$v ;; esac
    done < "$SIDEF"
fi
# `linux` only once the listener has proven it knows it (only a new listener
# emits a side line; an old one silently ignores `linux`). Otherwise the
# legacy `right`, which a new listener maps to linux anyway, so a press in
# the few ms before the side line lands still hops.
verb=right
[ -n "$mside" ] && verb=linux

# Fallback: an old il-jump exits 2 on `linux`, and the `right` retry hops.
# The remote shell is fish on Ryuk; this string is valid in fish 3 and sh.
send "$verb" || exec ssh -o BatchMode=yes -o ConnectTimeout=6 "$LINUX_HOST" \
    "~/.local/bin/il-jump linux 2>/dev/null || ~/.local/bin/il-jump right"

# The hop is already on its way; the rest is off its hot path (HOP-05). Pick
# the window nearest the Mac edge Ryuk hands back at on this workspace: the
# smallest left x when Ryuk is off the Mac's LEFT edge (side right), else the
# largest right edge (side left, or unknown: today's pick). Focus it now so
# it has focus when you come back, and tell Ryuk its centre x so the next hop
# here lands on it. No window: screen centre.
# CGWindowList gives the frames (no permission needed for bounds); AeroSpace
# window ids are CGWindowIDs, and its list drops the windows it parks
# off-screen for other workspaces. The side goes in as argv, never as text.
# ponytail: stale if the layout changes while you are on Ryuk; the landing
# then misses by that much and the focus stays on the old pick.
set -- $(/usr/bin/osascript -l JavaScript -e '
function run(a) {
    ObjC.import("CoreGraphics"); ObjC.import("AppKit");
    const side = a[0], want = new Set(a.slice(1).map(Number));
    const ws = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo(
        $.kCGWindowListOptionOnScreenOnly | $.kCGWindowListExcludeDesktopElements, 0)))
        .filter(w => want.has(w.kCGWindowNumber));
    if (!ws.length) return "- " + Math.round($.NSScreen.mainScreen.frame.size.width / 2);
    const r = w => w.kCGWindowBounds.X + w.kCGWindowBounds.Width;
    const l = w => w.kCGWindowBounds.X;
    const w = side === "right" ? ws.reduce((a, b) => l(b) < l(a) ? b : a)
                               : ws.reduce((a, b) => r(b) > r(a) ? b : a);
    return w.kCGWindowNumber + " " + Math.round(w.kCGWindowBounds.X + w.kCGWindowBounds.Width / 2);
}' "${mside:-unknown}" $(aerospace list-windows --workspace focused --format '%{window-id}') 2>/dev/null)
[ -n "${2:-}" ] || exit 0
[ "$1" = - ] || aerospace focus --window-id "$1"
send "aim $2"
