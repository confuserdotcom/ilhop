#!/bin/sh

# Unconditional "go to Linux" from the Mac - the mirror of ALT+C there.
# Bound to alt-c in aerospace.toml, or run by the il-hotkey-mac agent on a Mac
# without AeroSpace.
#
# NOTE it does NOT fake anything locally: input-leap only reacts to synthetic
# pointer motion on the SERVER, so this asks Linux to run il-jump linux, which
# walks the shared cursor off the Mac's edge and then recentres over there.
# Physical SUPER+C can't be used here: server.conf swaps ctrl/super on the Mac
# screen, so it arrives as Ctrl+C and would shadow terminal interrupt.
#
# Fast path: one line into the il-hop-pipe agent's live ssh session (~10ms,
# HOP-04). If the agent is down, nc fails at once and this falls back to a
# fresh ssh (~80ms warm, ~1.6s cold).

# Per-machine settings (ilhop config, written by install.sh).
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ilhop/config"
[ -r "$CONF" ] && . "$CONF"
LINUX_HOST="${ILHOP_LINUX_HOST:-ryuk}"   # ssh alias for the Linux machine
SOCK="$HOME/.local/state/il-hop.sock"
send() { printf '%s\n' "$1" | /usr/bin/nc -U "$SOCK" 2>/dev/null; }

send linux || exec ssh -o BatchMode=yes -o ConnectTimeout=6 "$LINUX_HOST" "~/.local/bin/il-jump linux"

. "$HOME/.local/bin/il-mac-wm"           # mac_pick, mac_focus

# The hop is already on its way; the rest is off its hot path (HOP-05). Pick
# the window nearest the edge Linux hands back at (see il-mac-wm), focus it
# now so it has focus when you come back, and tell Linux its centre x so the
# next hop here lands on it. No window: screen centre.
# ponytail: stale if the layout changes while you are on Linux; the landing
# then misses by that much and the focus stays on the old pick.
set -- $(mac_pick)
[ -n "${2:-}" ] || exit 0
[ "$1" = - ] || mac_focus "$1"
send "aim $2"
