<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ilhop.hop-pipe</string>
    <!-- Persistent ssh session to the Linux machine that il-jump-mac (alt-c)
         writes hop requests into, so the Mac->Linux hop skips a fresh ssh.
         Exits when the session dies; KeepAlive restarts it.
         @BIN@ is filled in by install.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>@BIN@/il-hop-pipe</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
