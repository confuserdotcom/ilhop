#!/bin/sh
# Teleport the pointer between Nastralis and the Mac over input-leap.
#
#   il-jump            same as `toggle`
#   il-jump toggle     go to whichever machine does NOT currently have the pointer
#   il-jump mac        go to the Mac
#   il-jump linux      come back to Nastralis
#   il-jump left|right go that way (whichever machine sits there)
#   il-jump side       print which side of this screen the Mac is on
#
# WHICH SIDE THE MAC IS ON
# Never configured. It is read live, on every hop, from input-leap's own
# server.conf: this screen's single left or right link in `section: links`
# (one awk, ~2ms). input-leap needs those links to match the desk for the
# physical mouse anyway, so they are the one source of truth; `ilhop side`
# rewrites them. A conf with no usable link falls back to "the Mac is on the
# left" and never blocks the hop.
#
# HOW THE CROSSING WORKS
# input-leap only switches screens when the pointer runs off a linked screen
# edge, and from then on it moves the Mac's pointer by the relative motion it
# captures here. Both legs are driven with ydotool, locally, in ~20-40ms.
#
# Neither leg may lean on a wall at the far edge: with wrap-around (the Mac
# linked on both sides) there is none, and anything that overshoots a screen
# keeps going onto the next one. So every distance below is exact, and that
# rests on one thing:
#
#  - The ydotool device has a FLAT acceleration profile (install.sh adds
#    `hl.device({ name = "ydotoold-virtual-device-1", accel_profile = "flat" })`
#    to user.lua; `ilhop doctor` checks it). With libinput's default adaptive
#    profile a delta lands anywhere from 1x to ~2x depending on how close the
#    previous event was (measured 2026-10-23: 396 -> 735, 954, 977), which no
#    fixed number survives. Flat: exactly 1:1 (3 x 300 -> 900, measured).
#
# TO THE MAC (cross_mac + centre_mac)
#  - Warp the pointer 1px inside the edge that faces the Mac (compositor, exact
#    and free), then one 5px push: it crosses every time and enters the Mac
#    ENTRY px in from its edge pixel facing Linux (measured 4 on either side:
#    input-leap logs `switch ... at 4,y` / `at 1465,y` on a 1470px Mac).
#    y is the monitor's middle, which keeps the Mac's hot corners out of it.
#  - The first motion after the crossing is dropped: input-leap freezes the
#    compositor pointer at once but starts forwarding a few ms later
#    (measured: with no throwaway 8 of 8 nudges lost). The Linux pointer is
#    frozen during that gap, so it cannot be seen from here. Hence: a 1px
#    vertical throwaway, the modifier flush (a few ms of useful work), a
#    second throwaway, then the nudge (measured 15/15 landed).
#  - The nudge is ONE move of (target - entry) px, 1:1 under the flat profile.
#  - Should the nudge still be dropped, the pointer sits at the entry edge.
#    The detached check below reads the Mac's x over ssh (~140ms warm) and
#    sends the missing distance; it only ever moves a pointer still parked
#    at that edge, so it never fights your hand.
#
# BACK TO LINUX (shove + arrive_nastralis)
#  - Three 800px steps away from the Mac. The pointer can be anywhere on the
#    Mac, so the total must exceed the Mac's width (2400 > 1470) yet stay
#    under Mac + Linux width (4030), or with wrap-around it would cross on
#    past Linux's far edge. Then the compositor warp sets the exact spot -
#    safe, because on this side the portal watches the edge barrier, not
#    input-leap's own cursor. Macs wider than 2400 logical px need a 4th step.
#
#  - NO sleeps between steps: switchDelay is gone from server.conf.
#  - `ydotool mousemove -a` (absolute) is broken on this stack; never use it.
#  - `ydotool key` defaults to a 12ms gap PER EVENT, so the modifier flush needs
#    `-d 0` or it alone costs ~104ms.

set -u

# Per-machine settings (ilhop config, written by install.sh); defaults match
# the original two machines.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ilhop/config"
[ -r "$CONF" ] && . "$CONF"
MAC_HOST="${ILHOP_MAC_HOST:-mac}"   # ssh alias for the Mac
SCREEN="${ILHOP_SCREEN:-$(uname -n)}"   # this machine's input-leap screen name (--name)
SERVERCONF="$HOME/.config/InputLeap/server.conf"   # its links say where the Mac sits

RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$RUN/il-side"          # written by il-side-watch.service
LOCK="$RUN/il-jump.lock"
WCACHE="$RUN/il-mac-width"
CCACHE="$RUN/il-ryuk-aim"     # "x y [address]" where a hop here lands, refreshed off the hot path
MCACHE="$RUN/il-mac-aim"      # x on the Mac to land at; il-jump-mac sends it as you leave the Mac
ECACHE="$RUN/il-ryuk-edge"    # "x y": 1px inside the edge facing the Mac, where cross_mac warps to
ENTRY=4                       # px in from its Linux-facing edge pixel where the Mac pointer enters (measured)
YSOCK="$RUN/.ydotool_socket"
DBGLOG="$RUN/ilhop-debug.log" # ILHOP_DEBUG-gated refusal log (D-11, D-12)
DBGARM="$RUN/ilhop-debug.on"  # file present = debug on, without exporting the var
DBGCAP=65536                  # bytes; $RUN is RAM-backed tmpfs, D-13 keeps this alive into Phase 4
RETRY="$RUN/il-jump.retry"    # last-refusal marker: "$dir $tsms" (D-17, 01-06 decision checkpoint)
# Window bounds for the double-press override below - both measured on this
# machine, not guessed (01-ROOTCAUSE.md, 01-06-SUMMARY.md):
#  - floor 200ms: a tight back-to-back loop of the SAME direction (il-repro
#    --stress's own alternating pattern) costs 12.9-22.3ms between repeats,
#    measured over 19 samples. The floor sits >9x above that, so a stress
#    test hammering a GENUINELY correct refusal never trips the override -
#    the guard's own warning (shoving again buries the pointer further
#    off-screen) still holds for anything at that speed.
#  - ceiling 5000ms: the smallest gap between two REAL same-direction
#    dispatches in ~4h of organic ILHOP_DEBUG logging was 67514ms. The
#    ceiling sits >13x below that - every real same-direction repeat this
#    user has ever produced sits comfortably outside it, while a human
#    noticing nothing happened and pressing again sits comfortably inside it.
RETRY_MIN_MS=200
RETRY_MAX_MS=5000

# Where a hop onto Nastralis lands (HOP-05): the centre of the window nearest
# the edge the Mac hands over at on the focused monitor's workspace - with
# the Mac on the left, the leftmost window by its left edge; on the right,
# the rightmost by its right edge (`--arg side`) - then the one nearest the
# monitor's vertical middle, plus its address so it can take focus. With no
# window, the monitor centre. Input: hyprctl's monitors and clients JSON,
# slurped. Output: "x y [address]".
AIM_JQ='(.[0] | map(select(.focused))[0] // .[0]) as $m
    | ($m.y + ($m.height / $m.scale) / 2) as $cy
    | [.[1][] | select(.workspace.id == $m.activeWorkspace.id and .mapped and (.hidden | not))]
    | if length == 0 then "\(($m.x + ($m.width / $m.scale) / 2) | floor) \($cy | floor)"
      else min_by([(if $side == "right" then -(.at[0] + .size[0]) else .at[0] end), ((.at[1] + .size[1] / 2) - $cy | fabs)])
      | "\((.at[0] + .size[0] / 2) | floor) \((.at[1] + .size[1] / 2) | floor) \(.address)" end'

# Where cross_mac warps to: 1px inside the outer edge of the monitor that
# faces the Mac (rightmost by right edge, or leftmost by left edge), at its
# vertical middle. Input: hyprctl's monitors JSON slurped, so `.[0]` is the
# monitor list - the same slurp aim_geom's batch makes. Output: "x y".
EDGE_JQ='.[0] | if $side == "right" then max_by(.x + .width / .scale)
        | "\((.x + .width / .scale - 2) | floor) \((.y + (.height / .scale) / 2) | floor)"
      else min_by(.x) | "\(.x + 1 | floor) \((.y + (.height / .scale) / 2) | floor)" end'

# Which side of this screen the Mac is on, from server.conf's links (D-1).
# Prints left or right when this screen's block has exactly one left/right
# link, or one of each (wrap-around: the mouse crosses at both edges) - then
# the FIRST one listed is where the Mac really sits and the way ALT+C walks.
# Anything else (no links section, no block for this screen, two links the
# same way) prints nothing and the caller falls back.
#  - `#` comments are stripped; only `section: links` .. `end` counts.
#  - A line ending in `:` with no `=` opens a screen block; it is this
#    screen's when its name, whitespace and colon removed, equals $me
#    case-insensitively - compared as strings, never as a regex built from
#    a name read out of the file.
#  - Each `=` line in that block gives a direction: the text before `=`,
#    with any `(a,b)` range and whitespace removed, lowercased.
# Measured ~1.8ms per call with BSD awk during planning.
SIDE_AWK='{ sub(/#.*/, ""); l = tolower($0); gsub(/[ \t\r]/, "", l) }
    l == "section:links" { inl = 1; blk = 0; next }
    !inl { next }
    l == "end" { inl = 0; blk = 0; next }
    l !~ /=/ && l ~ /:$/ { blk = (substr(l, 1, length(l) - 1) == tolower(me)); next }
    blk && l ~ /=/ { d = l; sub(/=.*/, "", d); sub(/\(.*/, "", d)
        if (d == "left" || d == "right") { c++; if (c == 1) s = d; seen[d] = 1 } }
    END { if (c == 1 || (c == 2 && seen["left"] && seen["right"])) print s }'

# Sets MAC_SIDE; returns 1 and assumes left when the conf cannot say (D-2).
mac_side() {
    MAC_SIDE=$(awk -v me="$SCREEN" "$SIDE_AWK" "$SERVERCONF" 2>/dev/null)
    case "$MAC_SIDE" in left|right) return 0 ;; esac
    MAC_SIDE=left
    return 1
}

# Sets want (the machine the pointer goes to), dir (the way it travels),
# step and burst from the verb in $1 and the cached side in $CUR; returns 2
# on a verb it does not know. left|right mean "go that way" (D-3). dir is the
# Mac's side going there and the opposite coming back (with wrap-around both
# ways cross; this is the one the Mac really sits on). Toward the Mac it is
# one 5px push after the edge warp; back, three 800px steps.
resolve() {
    case "$1" in
        toggle) if [ "$CUR" = mac ]; then want=nastralis; else want=mac; fi ;;
        mac)    want=mac ;;
        linux)  want=nastralis ;;
        left|right) if [ "$1" = "$MAC_SIDE" ]; then want=mac; else want=nastralis; fi ;;
        *) return 2 ;;
    esac
    if [ "$want" = mac ]; then dir=$MAC_SIDE; step=5; burst=1
    elif [ "$MAC_SIDE" = left ]; then dir=right; step=800; burst=3
    else dir=left; step=800; burst=3; fi
    if [ "$dir" = left ]; then step=-$step; fi
}

# ── test seams and the side query: before the lock, never any motion ────────
# il-repro --aim: run just the pick above on JSON from stdin. left|right pins
# the side; any other value reads the live one.
if [ -n "${IL_JUMP_AIM_TEST:-}" ]; then
    case "$IL_JUMP_AIM_TEST" in left|right) MAC_SIDE=$IL_JUMP_AIM_TEST ;; *) mac_side ;; esac
    exec jq -rs --arg side "$MAC_SIDE" "$AIM_JQ"
fi
# il-repro --edge: the same for cross_mac's warp target, on monitors JSON.
if [ -n "${IL_JUMP_EDGE_TEST:-}" ]; then
    case "$IL_JUMP_EDGE_TEST" in left|right) MAC_SIDE=$IL_JUMP_EDGE_TEST ;; *) mac_side ;; esac
    exec jq -rs --arg side "$MAC_SIDE" "$EDGE_JQ"
fi
# `il-jump side`: il-jump-listen and il-reset ask this, so it must never take
# the lock or touch ydotool.
if [ "${1:-}" = side ]; then
    mac_side || echo "il-jump: no single left/right link for '$SCREEN' in $SERVERCONF; assuming the Mac is on the left" >&2
    printf '%s\n' "$MAC_SIDE"
    exit 0
fi
# il-repro --resolve: IL_JUMP_RESOLVE_TEST=<cached side> prints the decision
# for the verb as "want dir step burst" and stops.
if [ -n "${IL_JUMP_RESOLVE_TEST:-}" ]; then
    CUR=$IL_JUMP_RESOLVE_TEST
    mac_side
    resolve "${1:-toggle}" || exit 2
    printf '%s %s %s %s\n' "$want" "$dir" "$step" "$burst"
    exit 0
fi

note() { notify-send -a il-jump "il-jump" "$1" 2>/dev/null || true; }
die()  { dbg "die: $1"; note "$1"; echo "il-jump: $1" >&2; exit 1; }

# Off by default: unless ILHOP_DEBUG is set or the arm file exists, this is a
# single `test` and nothing else - no fork, no syscall beyond the check.
# ${ILHOP_DEBUG:-} so `set -u` cannot abort on it being unset. One printf per
# line (POSIX write-atomicity up to PIPE_BUF under O_APPEND) so the
# synchronous path and the detached self-check below can never interleave a
# partial line; >> always, never > - truncating would erase another writer's
# history.
dbg() {
    [ -n "${ILHOP_DEBUG:-}" ] || [ -e "$DBGARM" ] || return 0
    printf '%s %s\n' "$(date +%Y-%m-%dT%H:%M:%S.%3N%z)" "$1" >> "$DBGLOG" 2>/dev/null
}

# Keeps the trailing half once the log exceeds DBGCAP. A concurrent appender
# still holding the old inode across the rename may lose the handful of
# lines it writes during that window - accepted cost of a rotation with no
# lock, on a log that only exists to be read after the fact.
dbg_rotate() {
    [ -n "${ILHOP_DEBUG:-}" ] || [ -e "$DBGARM" ] || return 0
    [ -f "$DBGLOG" ] || return 0
    sz=$(wc -c < "$DBGLOG" 2>/dev/null); sz=${sz:-0}
    [ "$sz" -gt "$DBGCAP" ] 2>/dev/null || return 0
    tmp="$DBGLOG.tmp.$$"
    tail -c "$((DBGCAP / 2))" "$DBGLOG" > "$tmp" 2>/dev/null && mv -f "$tmp" "$DBGLOG" 2>/dev/null
}
dbg_rotate

# ── single-flight ────────────────────────────────────────────────────────────
# A second press while a jump is still in flight is dropped rather than allowed
# to interleave its motion with the first one.
exec 9>"$LOCK" 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
    flock -n 9 || { dbg "stale-lock: another jump in flight, dropping this press"; exit 0; }
fi

# ── the uinput daemon has to be up or nothing moves at all ───────────────────
# Probe by actually talking to it. Testing for the socket FILE is not enough:
# stopping ydotoold leaves the socket behind, so `[ -S ... ]` still passes while
# every move fails with "Connection refused".
ydotool_ok() { ydotool mousemove -- 0 0 >/dev/null 2>&1; }
if ! ydotool_ok; then
    systemctl --user start ydotoold.service >/dev/null 2>&1
    n=0
    while ! ydotool_ok && [ "$n" -lt 30 ]; do sleep 0.05; n=$((n + 1)); done
    ydotool_ok || die "ydotoold will not start, so the pointer cannot be moved"
    # libinput and the capture portal need a beat to adopt the new virtual
    # device; without this the first shove after a revival gets swallowed.
    sleep 0.25
fi

# Reads into $CUR without a subshell - this sits in the hot path.
read_side() {
    CUR=unknown
    [ -r "$STATE" ] && { read -r CUR < "$STATE" || CUR=unknown; }
    [ -n "${CUR:-}" ] || CUR=unknown
}

# ── which way? ───────────────────────────────────────────────────────────────
read_side
mac_side || dbg "side-unknown: no single left/right link for '$SCREEN' in $SERVERCONF, assuming the Mac is on the left"
if ! resolve "${1:-toggle}"; then
    dbg "usage: bad-arg='${1:-}'"; echo "usage: il-jump [toggle|mac|linux|left|right|side]" >&2; exit 2
fi

# Already there. Happens when ALT+H fires at the edge while the pointer is
# already on the Mac; shoving again would only bury it further off-screen -
# UNLESS this is a same-direction press shortly after an identical refusal,
# in which case the cached side is presumably wrong and this press forces
# the hop through rather than repeating the silent no-op indefinitely
# (D-17, ROOTCAUSE property 1: "a second press shortly after the first
# forces the hop through"). Known, accepted cost: a genuinely correct
# same-direction double-press inside the window also fires - see
# RETRY_MIN_MS/RETRY_MAX_MS above for why this is rare enough to accept.
if [ "$CUR" = "$want" ]; then
    now_ms=$(date +%s%3N)
    rdir=""; rts=""
    [ -r "$RETRY" ] && read -r rdir rts < "$RETRY" 2>/dev/null
    case "${rts:-}" in ''|*[!0-9]*) rts=0 ;; esac
    delta=$((now_ms - rts))
    if [ "$rdir" = "$dir" ] && [ "$delta" -ge "$RETRY_MIN_MS" ] && [ "$delta" -le "$RETRY_MAX_MS" ]; then
        dbg "retry-forced: dir=$dir CUR=$CUR want=$want since_last_refusal=${delta}ms"
        rm -f "$RETRY" 2>/dev/null
        # fall through - do not exit; this press forces the normal dispatch
        # path below to run exactly as it would for any other jump.
    else
        printf '%s %s\n' "$dir" "$now_ms" > "$RETRY" 2>/dev/null
        dbg "already-on-side: dir=$dir CUR=$CUR want=$want"
        exit 0
    fi
fi

# ── helpers ──────────────────────────────────────────────────────────────────
shove() { # $1 = number of steps
    n=0
    while [ "$n" -lt "$1" ]; do ydotool mousemove -- "$step" 0; n=$((n + 1)); done
}

landed() { # $1 = how many 100ms ticks to wait for the side file to flip
    n=0
    while [ "$n" -lt "$1" ]; do
        read_side
        [ "$CUR" = "$want" ] && return 0
        [ "$CUR" = unknown ] && return 0     # watcher down: cannot judge, assume ok
        sleep 0.1
        n=$((n + 1))
    done
    return 1
}

hypr() { # works even from an ssh session, which has no instance signature
    HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -1 "$RUN/hypr" 2>/dev/null | head -n1)}" \
        hyprctl "$@" 2>/dev/null
}

aim_geom() { hypr -j --batch 'monitors; clients' | jq -rs --arg side "$MAC_SIDE" "$AIM_JQ" 2>/dev/null; }

# Reads the cached aim: asking hyprctl + jq live costs ~8ms of a ~48ms leg.
# ponytail: the cache is as fresh as the last jump (the self-check below
# refreshes it every time, including right after you leave for the Mac, and
# the layout here does not change while you are over there). A window closed
# in between lands the pointer on empty space and the focus is a no-op;
# query live if that ever bites.
read_aim() {
    aim=""
    [ -r "$CCACHE" ] && read -r aim < "$CCACHE"
    case "${aim:-}" in
        [0-9]*' '[0-9]*) : ;;
        *) aim=$(aim_geom) ;;
    esac
    case "${aim:-}" in
        [0-9]*' '[0-9]*) : ;;
        *) aim="1280 720" ;;
    esac
    ax=${aim%% *}; rest=${aim#* }; ay=${rest%% *}; addr=""
    [ "$rest" != "$ay" ] && addr=${rest#* }
}

centre_nastralis() {
    read_aim
    hypr dispatch "hl.dsp.cursor.move({ x = $ax, y = $ay })" >/dev/null
}

# A genuine arrival: warp onto the aimed window and give it focus (follow_mouse
# is 2 here, so the pointer alone would not). The warp emits no pointer event,
# so no client re-sets a cursor image and the pointer stays invisible until
# real motion (HOP-06): one real +1 motion redraws it and moves it 0px after a
# warp (sub-pixel, measured), so it needs no -1 to cancel it.
# Only for a genuine arrival: in the give-up rescue the Mac may still hold
# capture, and real motion there goes to input-leap, not here.
arrive_nastralis() {
    read_aim
    if [ -n "$addr" ]; then
        hypr --batch "dispatch hl.dsp.focus({ window = \"address:$addr\" }) ; dispatch hl.dsp.cursor.move({ x = $ax, y = $ay })" >/dev/null
    else
        hypr dispatch "hl.dsp.cursor.move({ x = $ax, y = $ay })" >/dev/null
    fi
    ydotool mousemove -- 1 0
}

mac_width() { # cached; only ever asks the Mac on a cold cache
    if [ -s "$WCACHE" ]; then cat "$WCACHE"; return; fi
    w=$(ssh -o BatchMode=yes -o ConnectTimeout=3 "$MAC_HOST" \
        'osascript -e "tell application \"Finder\" to get bounds of window of desktop"' 2>/dev/null \
        | tr -d ' ' | cut -d, -f3)
    case "${w:-}" in
        ''|*[!0-9]*) w=1710 ;;                  # default; deliberately not cached
        *) printf '%s\n' "$w" > "$WCACHE" ;;
    esac
    printf '%s\n' "$w"
}

mac_x() { # the Mac pointer's x right now, over ssh (~140ms warm); detached check only
    ssh -o BatchMode=yes -o ConnectTimeout=3 "$MAC_HOST" \
        "osascript -l JavaScript -e 'ObjC.import(\"AppKit\"); Math.round(\$.NSEvent.mouseLocation.x)'" 2>/dev/null
}

edge_geom() { hypr -j monitors | jq -rs --arg side "$MAC_SIDE" "$EDGE_JQ" 2>/dev/null; }

# Sets ex ey from the edge cache (builtin read, no fork once warm; the
# detached check refreshes it), else asks the compositor live.
read_edge() {
    edge=""
    [ -r "$ECACHE" ] && read -r edge < "$ECACHE"
    case "${edge:-}" in [0-9-]*' '[0-9]*) : ;; *) edge=$(edge_geom) ;; esac
    case "${edge:-}" in
        [0-9-]*' '[0-9]*) : ;;
        *) if [ "$MAC_SIDE" = right ]; then edge="2558 720"; else edge="1 720"; fi ;;
    esac
    ex=${edge%% *}; ey=${edge#* }
}

# Puts the pointer onto the Mac: warp beside the edge facing it, one push
# across, then the first of two throwaways (the first motion after the
# crossing is dropped - see HOW THE CROSSING WORKS).
cross_mac() {
    read_edge
    hypr dispatch "hl.dsp.cursor.move({ x = $ex, y = $ey })" >/dev/null
    ydotool mousemove -- "$step" 0
    ydotool mousemove -- 0 1
}

# Sets tx (the x on the Mac to land at) and mw (the Mac's width). The target
# is the centre of the Mac window nearest this edge, which il-jump-mac
# measured and focused as you last left the Mac (HOP-05); with none known,
# the screen centre. The width comes from the cache with a builtin read (no
# fork once warm; the detached check below warms it), falling back to asking
# the Mac.
mac_target() {
    tx=""; mw=""
    [ -r "$MCACHE" ] && read -r tx < "$MCACHE"
    [ -r "$WCACHE" ] && read -r mw < "$WCACHE"
    case "${mw:-}" in ''|*[!0-9]*) mw=$(mac_width) ;; esac
    case "${tx:-}" in ''|*[!0-9]*) tx=$(( mw / 2 )) ;; esac
}

# Where the pointer entered the Mac: ENTRY px in from the edge facing Linux.
entry_x() { if [ "$MAC_SIDE" = right ]; then echo "$ENTRY"; else echo "$(( mw - 1 - ENTRY ))"; fi; }

# Is the pointer on this machine? One 1px vertical move: the compositor
# pointer follows it here, and stays frozen while input-leap holds it for the
# Mac (where the same 1px lands, harmlessly). The side file only says what
# journald last reported; before shoving again this asks the pointer itself,
# because with wrap-around a shove on the wrong machine crosses on over the
# far edge.
on_linux() {
    p0=$(hypr cursorpos); py=${p0#*, }; d=1
    case "$py" in ''|*[!0-9]*) : ;; *) [ "$py" -gt 100 ] && d=-1 ;; esac   # never into a clamping edge
    ydotool mousemove -- 0 "$d"; sleep 0.05; p1=$(hypr cursorpos)
    [ -n "$p0" ] && [ "$p0" != "$p1" ]
}

# ONE move from the entry point to the target, 1:1 under the flat profile.
# ponytail: x only - y stays at the monitor middle cross_mac warped to.
centre_mac() {
    mac_target
    ydotool mousemove -- "$(( tx - $(entry_x) ))" 0
}

# ── go ───────────────────────────────────────────────────────────────────────
# Every jump stamps this. The background check below only intervenes if it is
# still the most recent one, so a follow-up press is never second-guessed.
SEQ="$RUN/il-jump.seq"
myseq="$$-$(date +%s%N)"
printf '%s\n' "$myseq" > "$SEQ"

dbg "dispatch: dir=$dir want=$want CUR=$CUR seq=$myseq"
if [ "$want" = mac ]; then cross_mac; else shove "$burst"; fi

# Drop any modifier still held from the keybind so it cannot stick on the far
# side. -d 0, or this alone costs ~104ms. Toward the Mac it also spaces the
# two throwaways apart.
ydotool key -d 0 125:0 126:0 29:0 97:0 56:0 100:0 42:0 54:0 2>/dev/null || true

# Recentre optimistically: the crossing itself is ~20ms, while confirmation has
# to come back through journald and takes a few hundred. Waiting for it here is
# what made this feel laggy, so the check runs detached instead. If the crossing
# did fail, the nudge only slides the pointer along this screen and the check
# below puts it back.
if [ "$want" = mac ]; then ydotool mousemove -- 0 1; centre_mac; else arrive_nastralis; fi

# ── detached self-check: did it actually land, and rescue it if not ──────────
(
    exec 9>&-                        # do not hold the single-flight lock
    geo=$(hypr -j --batch 'monitors; clients')   # refresh both caches off the hot path
    g=$(printf '%s' "$geo" | jq -rs --arg side "$MAC_SIDE" "$AIM_JQ" 2>/dev/null)
    case "$g" in [0-9]*' '[0-9]*) printf '%s\n' "$g" > "$CCACHE.$$" && mv -f "$CCACHE.$$" "$CCACHE" ;; esac
    g=$(printf '%s' "$geo" | jq -rs --arg side "$MAC_SIDE" "$EDGE_JQ" 2>/dev/null)
    case "$g" in [0-9-]*' '[0-9]*) printf '%s\n' "$g" > "$ECACHE.$$" && mv -f "$ECACHE.$$" "$ECACHE" ;; esac
    # centre_mac needs the Mac's width on every hop there, so warm the cache
    # here - one ssh per boot at most, never on the hot path.
    [ -s "$WCACHE" ] || mac_width >/dev/null
    mine() { [ "$(cat "$SEQ" 2>/dev/null)" = "$myseq" ]; }

    if landed 12; then               # ~1.2s; the side file flips after ~450ms
        [ "$want" = mac ] && [ "$CUR" = mac ] || exit 0
        # Landed on the Mac: was the nudge dropped? Then the pointer still
        # sits at the entry edge; send the missing distance. Only a pointer
        # parked there is touched, so a hand already on the mouse wins.
        mac_target; ent=$(entry_x)
        mx=$(mac_x)
        case "${mx:-}" in ''|*[!0-9-]*) exit 0 ;; esac
        off=$((mx - ent)); [ "$off" -lt 0 ] && off=$((-off))
        far=$((tx - ent)); [ "$far" -lt 0 ] && far=$((-far))
        if [ "$off" -le 30 ] && [ "$far" -gt 60 ] && mine; then
            dbg "renudge: mac x=$mx entry=$ent target=$tx"
            ydotool mousemove -- "$((tx - mx))" 0
        fi
        exit 0
    fi

    mine || { dbg "superseded: seq=$myseq now=$(cat "$SEQ" 2>/dev/null)"; exit 0; }   # a newer jump owns it now
    read_side; [ "$CUR" = unknown ] && { dbg "watcher-unknown: dir=$dir want=$want, cannot judge landing"; exit 0; }        # watcher down, cannot judge

    # One more try, the same bounded way: an unbounded shove would cross on
    # past the far edge when both edges are linked. But first ask the pointer
    # where it is: a late side file must not send it round again.
    if on_linux; then here=nastralis; else here=mac; fi
    if [ "$here" = "$want" ]; then
        dbg "retry-skipped: dir=$dir want=$want, the pointer is already there (side file late)"
        exit 0
    fi
    dbg "retry: dir=$dir want=$want"
    if [ "$want" = mac ]; then cross_mac; ydotool mousemove -- 0 1; else shove "$burst"; fi
    if landed 15; then
        if [ "$want" = mac ]; then centre_mac; else arrive_nastralis; fi
        exit 0
    fi

    # The other screen never took it: Mac asleep, client disconnected, network
    # gone. Do not leave the pointer buried against the edge.
    centre_nastralis
    note "the other screen didn't take the pointer (asleep or disconnected?)"
) >/dev/null 2>&1 &
