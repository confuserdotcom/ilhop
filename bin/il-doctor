#!/bin/sh
# Health check for the two-machine input-leap setup.
#
#   il-doctor           inspect everything, change nothing
#   il-doctor --test    also do a real round trip (Nastralis -> Mac -> back)
#
# Written so that when the screen hop misbehaves there is one thing to run
# instead of remembering where all the moving parts live.

# Per-machine settings (ilhop config, written by install.sh); defaults match
# the original two machines.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ilhop/config"
[ -r "$CONF" ] && . "$CONF"
MAC_HOST="${ILHOP_MAC_HOST:-mac}"
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
ok=0; bad=0
pass() { printf '  \033[32mok\033[0m    %s\n' "$1"; ok=$((ok+1)); }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; bad=$((bad+1)); }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; }
head() { printf '\n\033[1m%s\033[0m\n' "$1"; }

hypr() { # works even from an ssh session, which has no instance signature
    # copied verbatim from il-jump:140-143 (D-16) - the new live-round-trip
    # landing check needs this to resolve HYPRLAND_INSTANCE_SIGNATURE under ssh.
    # `command head` (not bare `head`), because this file's own head() reporting
    # function (defined above) shadows the coreutils binary - the exact bug
    # 01-02-SUMMARY.md documented finding and fixing in il-cursortrace's copy
    # of this same wrapper; fixed here before it is ever exercised.
    HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -1 "$RUN/hypr" 2>/dev/null | command head -n1)}" \
        hyprctl "$@" 2>/dev/null
}

head "pointer injection (ydotool)"
if systemctl --user is-active --quiet ydotoold.service; then
    pass "ydotoold.service running"
else
    fail "ydotoold.service NOT running   -> systemctl --user start ydotoold (if it keeps dying, see the /dev/uinput check below)"
fi
if ydotool mousemove -- 0 0 >/dev/null 2>&1; then
    pass "ydotool can talk to the daemon"
else
    fail "ydotool cannot reach the daemon (stale socket?)   -> systemctl --user restart ydotoold"
fi
# ydotoold (a user unit) writes /dev/uinput and il-heldmods reads
# /dev/input/event*: name the exact reason either would fail (PKG-01 #2).
if [ ! -e /dev/uinput ]; then
    fail "/dev/uinput does not exist   -> sudo modprobe uinput; echo uinput | sudo tee /etc/modules-load.d/uinput.conf"
elif [ -w /dev/uinput ] && [ -r /dev/uinput ]; then
    pass "/dev/uinput is readable and writable"
else
    ug=$(stat -c %G /dev/uinput); um=$(stat -c %A /dev/uinput)
    if id -nG | grep -qw "$ug"; then
        fail "/dev/uinput is $um root:$ug - your group '$ug' cannot write it   -> echo 'KERNEL==\"uinput\", GROUP=\"input\", MODE=\"0660\", OPTIONS+=\"static_node=uinput\"' | sudo tee /etc/udev/rules.d/80-uinput.rules; sudo udevadm control --reload; sudo udevadm trigger"
    elif getent group "$ug" | cut -d: -f4 | tr ',' '\n' | grep -qx "$USER"; then
        fail "you were added to '$ug' but this session predates it   -> log out and back in"
    else
        fail "/dev/uinput belongs to group '$ug' and you are not in it   -> sudo usermod -aG $ug $USER, then log out and back in"
    fi
fi
if id -nG | grep -qw input; then
    pass "user is in the 'input' group (il-heldmods reads /dev/input)"
else
    fail "user is NOT in the 'input' group   -> sudo usermod -aG input $USER, then log out and back in"
fi

head "input-leap server"
if systemctl --user is-active --quiet input-leap-server.service; then
    pass "input-leap-server.service running"
else
    fail "input-leap-server.service NOT running   -> systemctl --user restart input-leap-server"
fi
# UPSTREAM-01: the patched build carries a held modifier across the hop. A
# stock input-leap update silently replaces it.
strings "$(command -v input-leaps)" 2>/dev/null | grep -q 'held at capture start' \
    && pass "input-leap carries held modifiers across a hop (ilhop patch)" \
    || warn "stock input-leap: hold ALT through a hop and it is dropped   -> rebuild upstream/input-leap (see README)"
lvl=$(grep -o -- '--debug [A-Z]*' "$HOME/.config/systemd/user/input-leap-server.service" 2>/dev/null | awk '{print $2}')
[ "$lvl" = INFO ] && pass "log level INFO (side tracking needs it, and DEBUG floods the journal)" \
                  || warn "log level is ${lvl:-?}; INFO is what il-side-watch expects"
if journalctl --user -u input-leap-server.service --since "10 minutes ago" --no-pager 2>/dev/null \
       | grep -q 'has connected'; then
    pass "the Mac client has connected recently"
else
    warn "no 'has connected' in the last 10 min - the Mac may be asleep or off"
fi
conf="$HOME/.config/InputLeap/server.conf"
side="${ILHOP_MAC_SIDE:-left}"
grep -qE "^[[:space:]]*$side *= *[^[:space:]]" "$conf" 2>/dev/null \
    && pass "server.conf: the Mac is the $side link (ILHOP_MAC_SIDE)" \
    || fail "server.conf: no $side link, but ILHOP_MAC_SIDE says the Mac sits $side   -> fix server.conf or ILHOP_MAC_SIDE in $CONF"
grep -qE '^[[:space:]]*switchDelay' "$conf" 2>/dev/null \
    && warn "server.conf still sets switchDelay - that reintroduces the laggy edge" \
    || pass "server.conf: no switchDelay (edges cross instantly)"

head "side tracking"
if systemctl --user is-active --quiet il-side-watch.service; then
    pass "il-side-watch.service running"
else
    fail "il-side-watch.service NOT running (toggle loses its sense of direction)"
fi
# systemctl is-active alone cannot tell a healthy watcher from one
# crash-looping under Restart=always/RestartSec=3 -- CR-01 measured it
# reporting `active` on roughly 1 in 10 polls mid-loop. systemd itself logs
# "Scheduled restart job, restart counter is at N" to the unit's own journal
# on every Restart=always cycle (confirmed live this session, systemd 261,
# ~3s cadence at RestartSec=3), so two or more of those lines inside a
# trailing 10-second window is not one legitimate restart -- it is a loop.
# History-based: adds no sleep, and self-expires as the window slides, with
# no state to reset. journalctl producing nothing (unit never restarted, or
# unreadable) defaults the count to 0 rather than warning or crashing.
restarts=$(journalctl --user -u il-side-watch.service --since "-10s" --no-pager 2>/dev/null \
               | grep -c 'Scheduled restart job' 2>/dev/null)
case "$restarts" in
    ''|*[!0-9]*) restarts=0 ;;
esac
if [ "$restarts" -ge 2 ]; then
    fail "il-side-watch.service is crash-looping ($restarts restarts in the last 10s)   -> journalctl --user -u il-side-watch.service --since '-30s'"
else
    pass "il-side-watch.service restart history looks healthy ($restarts restart(s) in the last 10s)"
fi
if [ -s "$RUN/il-side" ]; then
    pass "pointer is currently on: $(cat "$RUN/il-side")"
else
    fail "no side file at $RUN/il-side"
fi

head "keybinds on this machine"
binds=$(hypr binds -j)
if [ -z "$binds" ]; then
    fail "cannot reach Hyprland (not running in this session?) - ALT + C not checked"
else
    echo "$binds" | jq -e 'any(.[]; (.key|ascii_downcase)=="c" and .modmask==8)' >/dev/null 2>&1 \
        && pass "ALT + C bound (jump toggle)" || fail "ALT + C not bound   -> re-run install.sh, or bind it to ilhop toggle"
fi
wm=$(. "$HOME/.local/bin/il-wm" 2>&1 && echo "$ILHOP_WM")
case "$wm" in
    hyprland-lua|hyprland) pass "window-manager adapter: $wm" ;;
    *) fail "window-manager adapter: ${wm:-$HOME/.local/bin/il-wm missing}   -> set ILHOP_WM in $CONF, or re-run install.sh" ;;
esac
for s in ilhop il-jump il-side-watch il-heldmods; do
    [ -x "$HOME/.local/bin/$s" ] && pass "$s present and executable" || fail "$HOME/.local/bin/$s missing"
done

if latched=$("$HOME/.local/bin/il-heldmods" 2>/dev/null | tr '\n' ' '); then
    [ -z "$latched" ] \
        && pass "no modifier latched down" \
        || warn "modifier keycode(s) reported held: $latched (fine if you are holding one)"
else
    fail "il-heldmods cannot read /dev/input (input group? rebuild: gcc -O2 -o ~/.local/bin/il-heldmods ~/.local/src/il-heldmods.c)"
fi

head "the Mac"
if t=$( { TIMEFORMAT=%R; time ssh -o BatchMode=yes -o ConnectTimeout=5 "$MAC_HOST" true; } 2>&1 ); then
    pass "ssh to the Mac works (${t}s; >1s means the control master went cold)"
else
    fail "cannot ssh to the Mac as '$MAC_HOST' without a password   -> check ILHOP_MAC_HOST in ~/.config/ilhop/config, your ssh keys, and that the Mac is awake"
fi
if ssh -o BatchMode=yes -o ConnectTimeout=5 "$MAC_HOST" 'test -x ~/.local/bin/il-jump-mac' 2>/dev/null; then
    pass "il-jump-mac present on the Mac"
else
    fail "il-jump-mac missing on the Mac"
fi
macbinds=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$MAC_HOST" 'grep -cE "^alt-c = .*il-jump-mac" ~/.config/aerospace/aerospace.toml' 2>/dev/null)
[ "${macbinds:-0}" -ge 1 ] && pass "aerospace binds alt-c to il-jump-mac" \
                           || fail "aerospace alt-c does not run il-jump-mac   -> check ~/.config/aerospace/aerospace.toml"
ssh -o BatchMode=yes -o ConnectTimeout=5 "$MAC_HOST" 'test -S ~/.local/state/il-hop.sock' 2>/dev/null \
    && pass "il-hop-pipe session up on the Mac (fast Mac->Ryuk leg)" \
    || fail "il-hop-pipe down: Mac ALT+C falls back to slow ssh   -> launchctl kickstart -k gui/\$(id -u)/ilhop.hop-pipe (on the Mac)"
ssh -o BatchMode=yes -o ConnectTimeout=5 "$MAC_HOST" 'pgrep -q -f input-leapc' 2>/dev/null \
    && pass "input-leap client running on the Mac" \
    || fail "input-leap client NOT running on the Mac   -> launchctl kickstart gui/\$(id -u)/com.input-leap.client"
[ -s "$RUN/il-mac-width" ] && pass "Mac width cached: $(cat "$RUN/il-mac-width")px" \
                           || warn "Mac width not cached yet - the first jump will fetch it"
[ -s "$RUN/il-mac-aim" ] && pass "Mac landing aimed at x=$(cat "$RUN/il-mac-aim") (window nearest the edge)" \
                         || warn "no Mac landing aim yet - hops land mid-screen until you next leave the Mac with ALT+C"

if [ "${1:-}" = "--test" ]; then
    head "live round trip"
    # The verdict below no longer comes from $RUN/il-side (D-16's circularity -
    # a stale-but-unchanged cache could make this pass while the hop did
    # nothing). It comes from il-cursortrace --landed, the local-freeze oracle
    # 01-A1-RESULT.md measured and licensed. The cache is still reported, at
    # warn level, as what it currently believes - never as the verdict.
    ORACLE="$HOME/.local/bin/il-cursortrace"
    report_cache() { # $1 = expected side, for the agree/disagree note
        c=$(cat "$RUN/il-side" 2>/dev/null)
        pos=$(hypr cursorpos 2>/dev/null)   # routes this check through the hypr() wrapper (D-16 key-link)
        if [ "$c" = "$1" ]; then
            warn "cache believes: ${c:-unset} (agrees with the oracle) - hyprctl cursorpos: ${pos:-unavailable}"
        else
            warn "cache believes: ${c:-unset} (disagrees with the oracle's $1 - the exact condition this phase exists to catch) - hyprctl cursorpos: ${pos:-unavailable}"
        fi
    }

    start=$(cat "$RUN/il-side" 2>/dev/null)
    [ "$start" = mac ] && { "$HOME/.local/bin/il-jump" right >/dev/null 2>&1; sleep 2; }

    t0=$(date +%s%3N); "$HOME/.local/bin/il-jump" toggle >/dev/null 2>&1; t1=$(date +%s%3N); sleep 2
    if "$ORACLE" --landed mac >/dev/null 2>&1; then
        pass "hop to the Mac: $((t1-t0))ms"
    else
        fail "hop to the Mac did not land"
    fi
    report_cache mac

    t0=$(date +%s%3N); "$HOME/.local/bin/il-jump" toggle >/dev/null 2>&1; t1=$(date +%s%3N); sleep 2
    if "$ORACLE" --landed nastralis >/dev/null 2>&1; then
        pass "hop back: $((t1-t0))ms"
    else
        fail "hop back did not land"
    fi
    report_cache nastralis
fi

printf '\n%s check(s) ok, %s failed\n' "$ok" "$bad"
[ "$bad" -eq 0 ] || exit 1
