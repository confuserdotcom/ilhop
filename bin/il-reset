#!/bin/sh
# Panic button for the two-machine setup: unstick everything and bring the
# pointer home. Safe to run at any time, from anywhere.
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOCK="$RUN/il-jump.lock"

# Hold il-jump's single-flight lock for the whole reset (DIAG-02): a hop in
# flight finishes its ~25ms first, and a hop pressed during the reset is
# dropped by il-jump's own `flock -n` instead of interleaving with it. Never
# delete the lock file: a new il-jump would lock a fresh inode and both would
# run. If a wedged hop holds it past 2s, kill it and take the lock anyway.
echo "il-reset: waiting for any in-flight jump"
exec 9>"$LOCK"
# Pattern ends at il-jump or il-jump + space so il-jump-listen (the Mac's live
# pipe session) is never matched.
kill_jumps() { pkill -f '/il-jump( |$)' 2>/dev/null; }
if ! flock -w 2 9; then
    echo "il-reset: a jump is wedged, killing it"
    kill_jumps; flock -w 2 9 || echo "il-reset: could not take the lock, continuing anyway" >&2
fi
# Detached self-checks drop the lock by design; stop them so a late retry
# shove cannot land in the middle of the reset.
kill_jumps
rm -f "$RUN/il-jump.seq"

# Test seam for il-repro --reset-race: hold the lock this long, then stop.
if [ -n "${IL_RESET_DRY:-}" ]; then
    echo "il-reset: locked at $(date +%s%3N)"; sleep "$IL_RESET_DRY"; exit 0
fi

echo "il-reset: releasing every modifier"
for i in 1 2 3; do
    ydotool key -d 0 125:0 126:0 29:0 97:0 56:0 100:0 42:0 54:0 58:0 127:0 2>/dev/null
    sleep 0.05
done

echo "il-reset: resetting the virtual input device"
systemctl --user restart ydotoold.service 2>/dev/null
sleep 1

echo "il-reset: restarting the input relay"
systemctl --user restart input-leap-server.service 2>/dev/null
systemctl --user restart il-side-watch.service 2>/dev/null
sleep 3

echo "il-reset: pulling the pointer back to this machine"
i=0; while [ "$i" -lt 14 ]; do ydotool mousemove -- 800 0; i=$((i + 1)); done
sleep 1
# Subshell: a broken adapter setting must not stop the reset from finishing.
(
    CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ilhop/config"
    [ -r "$CONF" ] && . "$CONF"
    # install.sh puts il-wm next to this script; resolve links only if not.
    if [ -r "${0%/*}/il-wm" ]; then . "${0%/*}/il-wm"; else self=$(readlink -f "$0"); . "${self%/*}/il-wm"; fi
    set -- $(wm_aim)
    wm_warp "${1:-1280}" "${2:-720}"
) >/dev/null 2>&1

printf 'il-reset: done. pointer is on: %s\n' "$(cat "$RUN/il-side" 2>/dev/null || echo '?')"
echo "il-reset: modifiers held: '$("$HOME/.local/bin/il-heldmods" 2>/dev/null | tr '\n' ' ')' (empty is good)"
